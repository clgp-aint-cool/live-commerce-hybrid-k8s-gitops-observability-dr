          "expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\", pod=~\"($deployment)-[a-z0-9]{8,10}-[a-z0-9]{5}\", pod=~\"$pod\", container!=\"\"}[$__rate_interval])) / sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\", pod=~\"($deployment)-[a-z0-9]{8,10}-[a-z0-9]{5}\", pod=~\"$pod\", container!=\"\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{pod}}",
